# SAM-Audio-Infer Environment Configuration
# Copy this file to .env and fill in your values

# HuggingFace Token (required for downloading SAM-Audio models)
# Get your token at: https://huggingface.co/settings/tokens
# You must also request access at: https://huggingface.co/facebook/sam-audio-base
HF_TOKEN=your_huggingface_token_here

# Alternative variable name (also supported)
# HUGGINGFACE_TOKEN=your_huggingface_token_here
